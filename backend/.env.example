# =====================================================================
# INSIGHT - Backend Environment Template
# ---------------------------------------------------------------
# 1. Copy this file to `.env`   (cp .env.example .env)
# 2. Fill in the secrets marked "FILL ME" below.
# 3. NEVER commit `.env` to Git. Only this template (with empty
#    secret values) is committed.
# =====================================================================

# ---------- Application ----------
APP_NAME=INSIGHT
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# ---------- Ports (deliberately unconventional) ----------
# Common dev ports (3000/3001/8000/8080/5432/6379) are usually occupied
# by other projects, so INSIGHT binds collision-proof ports.
# Container-internal ports stay standard; only host bindings change.
API_PORT=9056              # Host port for FastAPI backend (container listens on 8000)
FRONTEND_PORT=5513         # Frontend dev-server port (must match CORS_ORIGINS)

# ---------- Database (PostgreSQL) ----------
# URL used INSIDE the Docker network (service name "postgres")
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/insight
POSTGRES_PORT_HOST=55432   # Host port for local psql (avoids clash with local Postgres)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=insight

# ---------- Redis ----------
REDIS_URL=redis://redis:6379/0
REDIS_PORT_HOST=56379      # Host port for redis-cli (avoids clash with local Redis)

# ---------- Authentication ----------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=            # FILL ME (app fails fast at startup if empty)
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- Financial Modeling Prep (server-side ONLY) ----------
FMP_API_KEY=               # FILL ME (leave empty if MARKET_DATA_PROVIDER=mock)
FMP_BASE_URL=https://financialmodelingprep.com
FMP_TIMEOUT_SECONDS=10
FMP_MAX_RETRIES=2
MARKET_DATA_PROVIDER=fmp   # fmp | mock

# ---------- AI / LLM ----------
LLM_PROVIDER=openai        # openai | gemini | local
LLM_API_KEY=               # FILL ME (not needed when LLM_PROVIDER=local)
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30

# ---------- CORS ----------
CORS_ORIGINS=http://localhost:5513,http://127.0.0.1:5513

# ---------- Rate limiting (slowapi + Redis) ----------
RATE_LIMIT_DEFAULT_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_AI_PER_MINUTE=20
