# INSIGHT backend environment template (ARCHITECTURE.md Appendix A).
# Copy to .env and fill in secrets. NEVER commit .env.

# App
APP_NAME=INSIGHT
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# Ports
API_PORT=9056
FRONTEND_PORT=5513

# Database (in-network names resolve inside docker-compose)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/insight
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=insight

# Redis
REDIS_URL=redis://redis:6379/0

# Auth (fill in a strong random secret, >= 32 bytes)
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# FMP (server-side only; leave empty for mock/offline)
FMP_API_KEY=
FMP_BASE_URL=https://financialmodelingprep.com
FMP_TIMEOUT_SECONDS=10
FMP_MAX_RETRIES=2
MARKET_DATA_PROVIDER=fmp   # fmp | mock

# LLM
LLM_PROVIDER=openai         # openai | gemini | local
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_GEMINI_MODEL=gemini-1.5-flash
LLM_TIMEOUT_SECONDS=30

# CORS
CORS_ORIGINS=http://localhost:5513,http://127.0.0.1:5513

# Rate limiting
RATE_LIMIT_DEFAULT_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_AI_PER_MINUTE=20
RATE_LIMIT_ENABLED=true

# Cache TTLs (seconds)
CACHE_TTL_PROFILE=86400
CACHE_TTL_QUOTE=300
CACHE_TTL_METRICS=1800
CACHE_TTL_STATEMENTS=86400
CACHE_TTL_HISTORY=86400
CACHE_TTL_ANALYSIS=1800
CACHE_TTL_SEARCH=600
CACHE_TTL_DASHBOARD=300
CACHE_TTL_SCREENER=900
CACHE_TTL_PORTFOLIO_ANALYSIS=600
